Package: WorldFloraFast
Type: Package
Title: Fast Standardization of Plant Names Against the World Flora
        Online Taxonomic Backbone
Version: 1.0.8
Date: 2026-10-19
Authors@R: 
    c(person(given = "Jérôme", family = "Chave",
             role = c("aut", "cre"),
